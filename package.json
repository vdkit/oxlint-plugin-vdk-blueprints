{
  "name": "@vdkit/oxlint-plugin-blueprints",
  "version": "1.0.0",
  "description": "Oxlint plugin for validating VDK blueprint/frontmatter contracts",
  "keywords": [
    "blueprints",
    "lint",
    "oxlint",
    "plugin",
    "vdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vdkit/oxlint-plugin-vdk-blueprints.git"
  },
  "bin": {
    "vdk-blueprints-fix": "./dist/fix.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src",
    "prepublishOnly": "pnpm run check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.73.0",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
